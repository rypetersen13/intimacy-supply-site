rules_version = '2';

// Intimacy Supply Firestore rules (version 2). Replaces the earlier rules that let any signed-in user
// edit their own membership and tokens, let anyone read affiliate access codes and write to
// products and meta, and left reviews without any rules.
//
// Principle: the browser may edit ITS OWN profile-type data, but never grant itself money,
// membership, tokens or order status. Those change only on the server (Netlify functions use a
// service account, which bypasses these rules).

service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.uid == 'CAssJZ6lGGXfCeukLIZwaOouDjR2'; }
    function short(s, n) { return s is string && s.size() <= n; }

    // Public to read, admin to change.
    match /products/{id} { allow read: if true; allow write: if isAdmin(); }
    match /meta/{doc}    { allow read: if true; allow write: if isAdmin(); }

    match /users/{uid} {
      allow read: if isOwner(uid) || isAdmin();

      // New accounts start as non-members with no tokens.
      allow create: if isOwner(uid)
        && request.resource.data.get('isVIP', false) == false
        && request.resource.data.get('credits', 0) == 0;

      // Owners can edit their profile but cannot make themselves a member, add tokens, or touch
      // billing and partner fields. They can still lower tokens (spending them).
      allow update: if isAdmin() || (isOwner(uid)
        && (request.resource.data.get('isVIP', false) == false
            || request.resource.data.get('isVIP', false) == resource.data.get('isVIP', false))
        && request.resource.data.get('credits', 0) <= resource.data.get('credits', 0)
        && !request.resource.data.diff(resource.data).affectedKeys().hasAny([
             'ccbillSubscriptionId', 'vipProvider', 'vipActivatedAt', 'vipLastEvent',
             'vipLastEventAt', 'vipDeactivatedAt', 'vipDeactivationReason',
             'lastTokenIssuedAt', 'vipExpires', 'affiliate', 'creator', 'role']));

      allow delete: if isOwner(uid) || isAdmin();
    }

    // A customer can place an unpaid order for themselves and read their own orders. Only the server
    // or the admin can change an order afterwards, so nobody can mark their own order paid.
    match /orders/{orderId} {
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.paymentStatus == 'unpaid'
        && request.resource.data.status == 'pending'
        && !('expectedTotal' in request.resource.data)
        && !('paidAt' in request.resource.data);
      allow read: if isAdmin() || (signedIn() && resource.data.userId == request.auth.uid);
      allow update: if isAdmin();
      allow delete: if false;
    }

    // Reviews are public once approved; new reviews arrive unapproved.
    match /reviews/{id} {
      allow read: if resource.data.approved == true || isAdmin();
      allow create: if signedIn()
        && request.resource.data.userId == request.auth.uid
        && request.resource.data.approved == false
        && short(request.resource.data.text, 2000);
      allow update, delete: if isAdmin();
    }

    match /restock_notify/{id} {
      allow create: if signedIn() && request.resource.data.userId == request.auth.uid;
      allow read, update, delete: if isAdmin();
    }

    match /cancellations/{id}         { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow read, update, delete: if isAdmin(); }
    match /cancellation_requests/{id} { allow create: if signedIn() && request.resource.data.userId == request.auth.uid; allow read, update, delete: if isAdmin(); }

    match /gift_card_orders/{id} { allow create: if signedIn(); allow read, update, delete: if false; }

    // Partner records hold access codes and payout emails. Partners use the "affiliate" server
    // function; only the admin panel and the server touch these collections.
    match /affiliates/{handle} { allow read, write: if isAdmin(); }
    match /payouts/{id}        { allow read, write: if isAdmin(); }

    // Public partner application form.
    match /partner_applications/{id} {
      allow create: if request.resource.data.status == 'pending' && short(request.resource.data.get('email', ''), 200);
      allow read, update: if isAdmin();
      allow delete: if false;
    }

    // Retired features: existing data stays readable by the admin only; nobody can add more.
    match /founding_members/{id}  { allow read, update, delete: if isAdmin(); }
    match /founding_waitlist/{id} { allow read, update, delete: if isAdmin(); }

    // Everything else: admin only.
    match /{document=**} { allow read, write: if isAdmin(); }
  }
}
